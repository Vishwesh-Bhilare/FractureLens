<!doctype html><html><head><meta charset="utf-8"><title>Case {{ report.case_id }} Report</title><style>body{font-family:Arial,sans-serif;max-width:1100px;margin:2rem auto;line-height:1.45;color:#222}table{border-collapse:collapse;width:100%;margin:.5rem 0 1.5rem}th,td{border:1px solid #ddd;padding:.45rem;text-align:right}th:first-child,td:first-child{text-align:left}th{background:#f2f2f2}.note{background:#fff7d6;padding:.8rem;border-left:4px solid #d6a600}img{max-width:100%;border:1px solid #ddd}.color-key{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;margin:.25rem 0 .75rem}.swatch{display:inline-block;width:.85rem;height:.85rem;border:1px solid #777;border-radius:2px;margin-right:.25rem;vertical-align:-.1rem}</style></head><body>
<header><h1>FractureLens Case Report</h1><p><b>Case ID:</b> {{ report.case_id }}<br><b>Generated:</b> {{ report.computed_at }}<br><b>Dataset:</b> {{ dataset_name }}</p></header>
<section><h2>Summary</h2><p><b>Fractured bones:</b> {{ report.fractured_bones|join(', ') if report.fractured_bones else 'None' }}<br><b>Intact bones:</b> {{ report.intact_bones|join(', ') if report.intact_bones else 'None' }}<br><b>Missing bones:</b> {{ report.missing_bones|join(', ') if report.missing_bones else 'None' }}<br><b>Total fragment count:</b> {{ report.total_fragment_count }}<br><b>Illustrative severity score, not a clinical measure:</b> {{ '%.3f'|format(report.severity_score) }}</p></section>
<section><h2>Per-bone breakdown</h2>{% for bone in by_bone %}<h3>{{ bone.name }}</h3><p>Fragment count: {{ bone.fragment_count }}</p><table><thead><tr><th>Fragment ID</th><th>Volume (mm³)</th><th>Surface Area (mm²)</th><th>Nearest Neighbor Distance (mm)</th></tr></thead><tbody>{% for f in bone.fragments %}<tr><td>{{ f.fragment_id }}</td><td>{{ '%.3f'|format(f.volume_mm3) }}</td><td>{{ '%.3f'|format(f.surface_area_mm2) if f.surface_area_mm2 is not none else '—' }}</td><td>{{ '%.3f'|format(f.nearest_neighbor_dist_mm) if f.nearest_neighbor_dist_mm is not none else '—' }}</td></tr>{% else %}<tr><td colspan="4">No labeled voxels found.</td></tr>{% endfor %}</tbody></table>{% endfor %}</section>
<section><h2>Slice thumbnails</h2>{% for image in slice_images %}<h3>{{ image.bone_name }}</h3><p>Representative axial slice: z={{ image.z_index }}</p><img src="{{ image.data_uri }}" alt="{{ image.bone_name }} axial slice">{% else %}<p>No fractured bones; no fracture slice thumbnails generated.</p>{% endfor %}</section>
<section><h2>3D render</h2>{% if color_key %}<p class="color-key">{% for item in color_key %}<span><span class="swatch" style="background-color: {{ item.hex }}"></span>{{ item.name }}</span>{% endfor %}</p>{% endif %}{% if render3d_html %}<p>Interactive combined render of all labeled bone fragments — drag to rotate, scroll to zoom.</p>{{ render3d_html|safe }}{% else %}<p class="note">{{ render3d_note or 'No labeled bone fragments found for this case.' }}</p>{% endif %}</section>
<footer><h2>Footer</h2><p>All metrics are derived from the ground-truth PENGWIN labels, not a model prediction.</p><p><code>volume_mm3</code> is voxel-count-based (exact); <code>surface_area_mm2</code> is mesh-derived (approximate) and depends on Taubin smoothing iterations used: {{ mesh_smooth_iterations }}.</p></footer>
</body></html>
